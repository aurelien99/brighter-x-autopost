# ============================================================================
# BRIGHTER X AUTOPOST - Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# X / TWITTER API (OAuth 1.0a User Context)
# Generer ici : https://developer.twitter.com/en/portal/dashboard
# Permissions necessaires : Read & Write
# ----------------------------------------------------------------------------
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_SECRET=your_x_access_token_secret

# ----------------------------------------------------------------------------
# GOOGLE GEMINI AI
# Generer ici : https://aistudio.google.com/apikey
# Cle gratuite, pas besoin de carte bancaire pour le plan gratuit
# ----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# ----------------------------------------------------------------------------
# CONFIGURATION IA
# Modeles disponibles (gratuits) :
#   gemini-2.5-flash         (rapide, gratuit)
#   gemini-2.5-pro           (qualite, gratuit)
# ----------------------------------------------------------------------------
AI_MODEL=gemini-2.5-flash
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# ----------------------------------------------------------------------------
# MODE DE PUBLICATION
# true  = Publication automatique (sans validation)
# false = Review humaine en console (recommande)
# ----------------------------------------------------------------------------
AUTO_PUBLISH=false
