# ============================================================
# BRIGHTER X AUTOPOST - Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# X / TWITTER API (OAuth 1.0a User Context)
# Générer ici : https://developer.twitter.com/en/portal/dashboard
# Permissions nécessaires : Read & Write
# ------------------------------------------------------------
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_SECRET=your_x_access_token_secret

# ------------------------------------------------------------
# ANTHROPIC AI (Claude)
# Générer ici : https://console.anthropic.com/settings/keys
# ------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key

# ------------------------------------------------------------
# CONFIGURATION IA
# Modèles disponibles : claude-3-5-haiku-latest (rapide)
#                       claude-3-5-sonnet-20241022 (qualité)
#                       claude-sonnet-4-20250514 (premium)
# ------------------------------------------------------------
AI_MODEL=claude-3-5-haiku-latest
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7

# ------------------------------------------------------------
# MODE DE PUBLICATION
# false  = Revue humaine en console (recommandé)
# true   = Publication automatique directe (non recommandé)
# ------------------------------------------------------------
AUTO_PUBLISH=false

# ------------------------------------------------------------
# RATE LIMITING
# Délai en secondes entre chaque tweet du thread
# Recommandé : 3 à 5 secondes pour éviter les rate limits
# ------------------------------------------------------------
TWEET_SLEEP_SECONDS=3

# ------------------------------------------------------------
# OPTIONNEL : Autres providers AI (non utilisés par défaut)
# ------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key
# GROK_API_KEY=your_grok_api_key
